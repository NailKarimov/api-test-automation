meta {
  name: Find by status
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/pet/findByStatus?status=available
  body: none
  auth: none
}

params:query {
  status: available
}

assert {
  res.status: eq 200
}

tests {
  test("every pet in the answer has the requested status", function () {
    const pets = res.getBody();
    expect(pets).to.be.an("array").that.is.not.empty;
    expect(pets.every((p) => p.status === "available")).to.equal(true);
  });

  test("the new pet is listed, the sold control pet is not", function () {
    const ids = res.getBody().map((p) => p.id);
    expect(ids).to.include(bru.getVar("petId"));
    expect(ids).to.not.include(bru.getVar("controlId"));
  });
}
