{
  "name": "api-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "API test automation for public REST and GraphQL APIs (OpenWeather, Swagger Petstore, Rick and Morty): contract validation, CRUD lifecycle, boundary values, negative testing, schema drift, security headers. Playwright + TypeScript + zod + Allure.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:openweather": "playwright test --project=openweather",
    "test:petstore": "playwright test --project=petstore",
    "test:bruno": "cd collections/petstore && npx --yes @usebruno/cli@4.2.1 run -r --env local",
    "test:security": "playwright test --project=security",
    "test:graphql": "playwright test --project=graphql",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "allure:generate": "node scripts/allure-prepare.mjs && allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "prepare": "husky",
    "petstore:up": "docker compose -f infra/petstore/docker-compose.yml up -d --wait",
    "petstore:down": "docker compose -f infra/petstore/docker-compose.yml down -v"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-inspector/core": "8.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.7"
  }
}
